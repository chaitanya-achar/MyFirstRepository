pipeline {
    agent any

    parameters {
        string(name: 'MARKS', defaultValue: '', description: 'Comma separated list of marks')
    }

    stages {
        stage('Evaluate Marks') {
            steps {
                script {
                    def marks = params.MARKS.split(',').collect { it.trim().toInteger() }
                    def result = marks.any { it < 40 } ? 'Failed' : 'Passed'
                    echo "Result: ${result}"
                }
            }
        }
    }
}
